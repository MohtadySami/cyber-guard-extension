{
  "manifest_version": 3,
  "name": "Cyber Guard",
  "version": "0.1.0",
  "description": "Pauses downloads briefly while Cyber Guard performs a safety check.",
  "minimum_chrome_version": "114",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Cyber Guard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "downloads",
    "storage",
    "notifications",
    "alarms"
  ]
}